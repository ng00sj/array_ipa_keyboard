<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="btn_00" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill_horizontal</item>
        <item name="android:layout_margin">0dp</item>
        <item name="android:padding">2dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:fontFamily">@font/notosans_variablefont_wdth_wght</item>
    </style>

    <style name="btn_00_a" parent="btn_00">
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/key_bg_a</item>
    </style>
</resources>